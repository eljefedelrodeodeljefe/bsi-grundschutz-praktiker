{
  "version": "0.2",
  "language": "en,de",
  "dictionaries": ["en_US", "de_DE", "project-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "ignoreWords": ["organisation"],
  "ignorePaths": [
    ".venv/**",
    "data/**",
    "tests/**",
    "*.lock",
    ".git/**"
  ],
  "ignoreRegExpList": [
    "https?://[^\\s]+"
  ]
}
